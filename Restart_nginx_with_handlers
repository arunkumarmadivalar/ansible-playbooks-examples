---
 - name: update nginx config file and restart nginx with handlers
   hosts: servers
   become: yes
   vars:
    package: nginx
   tasks:
     -  name: install nginx using var
        apt:
          name: "{{package}}"
          state: present
          update_cache: yes

     -  name: update nginx config file
        copy:
          src: nginx.conf
          dest: /etc/nginx/nginx.conf
        notify:
          - Restart nginx
   handlers:
     - name: Restart nginx
       service:
         name: nginx
         state: restarted

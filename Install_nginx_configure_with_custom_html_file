---
 - name: install and configure nginx
   hosts: servers
   become: yes
   tasks:
     - name: install nginx
       apt:
         name: nginx
         state: present
         update_cache: yes
     - name: copy custom html file
       copy:
         src: index.html
         dest: /var/www/html

     - name: restart nginx
       service:
         name: nginx
         state: restarted

     - name: enable nginx
       service:
         name: nginx
         enabled: true

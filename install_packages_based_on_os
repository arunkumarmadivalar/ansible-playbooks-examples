---
- name: Install packages based on OS
  hosts: all
  become: yes

  vars:
    packages:
      - nginx
      - git
      - curl

  tasks:

    - name: Install required packages
      package:
        name: "{{ packages }}"
        state: present

    - name: Start and enable nginx
      service:
        name: nginx
        state: started
        enabled: yes



        
# This works on:

#Ubuntu/Debian
#CentOS/RHEL
#Rocky Linux
#AlmaLinux

#because Ansible automatically selects:

#apt for Debian-based systems
#yum/dnf for RedHat-based systems
